<UserControl x:Class="ekreta_wpf_.UserControls.UserControlfelhasznalok"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ekreta_wpf_.UserControls">
    <Grid>
        <DataGrid x:Name="datagridfelhasznalok"
                      Width="1100" Height="600"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionChanged="datagridfelhasznalok_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="felhasznalonev" Binding="{Binding FelhasznaloNev}">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Teljesnev" Binding="{Binding TeljeNev}">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Szerepkor id" Binding="{Binding Szerepkor}">

                </DataGridTextColumn>
                <DataGridTextColumn Header="Szerepkor nev" Binding="{Binding SzerepkorNev}">

                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel>
            <StackPanel></StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
